NRO_DB_PATH=./data/nro-boss.db
NRO_SERVER=Super 1
NRO_PAGE_SIZE=10
NRO_REQUEST_TIMEOUT_MS=10000
NRO_RETRY_COUNT=3
NRO_API_URL=https://service.dungpham.com.vn/api/thong-bao
NRO_PAGE_URL=https://service.dungpham.com.vn/thong-bao

# Danh sách boss thuộc Tiểu Đội Sát Thủ, phân tách bởi dấu phẩy.
NRO_BOSS_NAMES=Tiểu đội trưởng,Số 1,Số 2,Số 3,Số 4

# Tần suất worker (npm run watch) kiểm tra dữ liệu mới, tính bằng giây.
NRO_POLL_SECONDS=60
