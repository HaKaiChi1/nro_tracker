# Cấu hình crawler (dùng khi chạy `npm run update` local; trên GitHub Actions
# các giá trị mặc định trong src/lib/config.ts là đủ, không cần file này).
NRO_SERVER=Super 1
NRO_PAGE_SIZE=10
NRO_REQUEST_TIMEOUT_MS=10000
NRO_RETRY_COUNT=3
NRO_BASE_URL=https://service.dungpham.com.vn/thong-bao
NRO_NEXT_ACTION=408aadffb9130a58e96f7d7f9333bc65c5c27ac0ce

# Cấu hình SMTP để gửi email cảnh báo — trên GitHub thì khai báo các biến này
# trong repo Settings → Secrets and variables → Actions → Secrets (không commit).
# Ví dụ dùng Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=email của bạn, SMTP_PASS=App Password (không phải mật khẩu Gmail thường),
# MAIL_FROM=email gửi đi.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
