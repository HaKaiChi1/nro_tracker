NRO_DB_PATH=./data/nro.db
NRO_SERVER=Super 1
NRO_PAGE_SIZE=10
NRO_REQUEST_TIMEOUT_MS=10000
NRO_RETRY_COUNT=3
NRO_API_URL=https://service.dungpham.com.vn/api/thong-bao
NRO_PAGE_URL=https://service.dungpham.com.vn/thong-bao

# Tần suất worker (npm run watch) kiểm tra dữ liệu mới, tính bằng giây.
NRO_POLL_SECONDS=60

# Cấu hình SMTP để gửi email khi có thông báo mới — BẮT BUỘC phải điền đầy đủ.
# Ví dụ dùng Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=email của bạn, SMTP_PASS=App Password (không phải mật khẩu Gmail thường),
# MAIL_FROM=email gửi đi, MAIL_TO=email nhận cảnh báo mặc định.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
